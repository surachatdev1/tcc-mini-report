rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().split('@').size() == 2
        && request.auth.token.get('email_verified', false) == true;
    }

    function currentEmail() {
      return request.auth.token.email.lower();
    }

    function currentDomain() {
      return currentEmail().split('@')[1];
    }

    function isProtectedSuperAdminEmail(email) {
      return email in [
        'surachat.dev1@gmail.com',
        'nuonnaka@gmail.com'
      ];
    }

    function isSuperAdmin() {
      return hasVerifiedEmail() && isProtectedSuperAdminEmail(currentEmail());
    }

    function isAdmin() {
      return isSuperAdmin() || (
        hasVerifiedEmail()
        && exists(/databases/$(database)/documents/dashboard_admins/$(currentEmail()))
        && get(/databases/$(database)/documents/dashboard_admins/$(currentEmail())).data.active == true
        && get(/databases/$(database)/documents/dashboard_admins/$(currentEmail())).data.role == 'admin'
      );
    }

    function hasDashboardAccess() {
      return hasVerifiedEmail() && (
        isAdmin()
        || (
          exists(/databases/$(database)/documents/dashboard_members/$(currentEmail()))
          && get(/databases/$(database)/documents/dashboard_members/$(currentEmail())).data.active == true
        )
        || (
          exists(/databases/$(database)/documents/dashboard_domains/$(currentDomain()))
          && get(/databases/$(database)/documents/dashboard_domains/$(currentDomain())).data.active == true
        )
      );
    }

    function hasPrivateDashboardAccess() {
      return hasVerifiedEmail() && (
        isAdmin()
        || (
          exists(/databases/$(database)/documents/dashboard_members/$(currentEmail()))
          && get(/databases/$(database)/documents/dashboard_members/$(currentEmail())).data.active == true
        )
      );
    }

    function validAdminPolicy(email) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'email', 'displayName', 'role', 'active', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['schemaVersion', 'email', 'displayName', 'role', 'active', 'createdAt', 'createdBy'])
        && data.schemaVersion == 1
        && data.email == email
        && data.email == data.email.lower()
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.role == 'admin'
        && data.active == true
        && data.createdAt == request.time
        && data.createdBy == currentEmail();
    }

    function validMemberPolicy(email) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'email', 'displayName', 'authMethod', 'active', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['schemaVersion', 'email', 'displayName', 'authMethod', 'active', 'createdAt', 'createdBy'])
        && data.schemaVersion == 1
        && data.email == email
        && data.email == data.email.lower()
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.authMethod in ['google', 'password']
        && data.active == true
        && data.createdAt == request.time
        && data.createdBy == currentEmail();
    }

    function validDomainPolicy(domain) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'domain', 'active', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['schemaVersion', 'domain', 'active', 'createdAt', 'createdBy'])
        && data.schemaVersion == 1
        && data.domain == domain
        && data.domain == data.domain.lower()
        && data.domain.matches('^[a-z0-9][a-z0-9.-]*[a-z0-9]$')
        && data.active == true
        && data.createdAt == request.time
        && data.createdBy == currentEmail();
    }

    function validProvince(value) {
      return value in [
        'กรุงเทพมหานคร', 'กาญจนบุรี', 'พระนครศรีอยุธยา', 'ประจวบคีรีขันธ์',
        'ขอนแก่น', 'สุรินทร์', 'เชียงใหม่', 'น่าน', 'ลำปาง', 'ภูเก็ต', 'ปัตตานี', 'สงขลา'
      ];
    }

    function validRole(value) {
      return value in [
        'ผู้บริหารสถานศึกษา', 'ครู / ผู้รับผิดชอบความปลอดภัย',
        'ผู้ประสานงานกิจการนักเรียน', 'เจ้าหน้าที่สถานศึกษา',
        'ผู้บริหารหน่วยงาน', 'ผู้รับผิดชอบนโยบายหรือแผนงาน',
        'เจ้าหน้าที่ผู้ประเมิน', 'ผู้ประสานงานระดับพื้นที่'
      ];
    }

    function validAnswer(answer) {
      return answer is map
        && answer.keys().hasAll(['score', 'explanation'])
        && answer.keys().hasOnly(['score', 'explanation'])
        && answer.score is int
        && answer.score >= 0
        && answer.score <= 3
        && answer.explanation is string
        && answer.explanation.size() <= 500;
    }

    function exactAnswerKeys(answers, keys) {
      return answers.keys().hasAll(keys) && answers.keys().hasOnly(keys);
    }

    function validBusAnswers(answers) {
      return exactAnswerKeys(answers, [
          'bus-driver-1', 'bus-driver-2', 'bus-driver-3',
          'bus-vehicle-1', 'bus-vehicle-2', 'bus-vehicle-3',
          'bus-management-1', 'bus-management-2', 'bus-management-3'
        ])
        && validAnswer(answers['bus-driver-1'])
        && validAnswer(answers['bus-driver-2'])
        && validAnswer(answers['bus-driver-3'])
        && validAnswer(answers['bus-vehicle-1'])
        && validAnswer(answers['bus-vehicle-2'])
        && validAnswer(answers['bus-vehicle-3'])
        && validAnswer(answers['bus-management-1'])
        && validAnswer(answers['bus-management-2'])
        && validAnswer(answers['bus-management-3']);
    }

    function validTripAnswers(answers) {
      return exactAnswerKeys(answers, [
          'trip-driver-1', 'trip-driver-2', 'trip-driver-3',
          'trip-vehicle-1', 'trip-vehicle-2', 'trip-vehicle-3',
          'trip-school-1', 'trip-school-2', 'trip-school-3',
          'trip-support-1', 'trip-support-2', 'trip-support-3'
        ])
        && validAnswer(answers['trip-driver-1'])
        && validAnswer(answers['trip-driver-2'])
        && validAnswer(answers['trip-driver-3'])
        && validAnswer(answers['trip-vehicle-1'])
        && validAnswer(answers['trip-vehicle-2'])
        && validAnswer(answers['trip-vehicle-3'])
        && validAnswer(answers['trip-school-1'])
        && validAnswer(answers['trip-school-2'])
        && validAnswer(answers['trip-school-3'])
        && validAnswer(answers['trip-support-1'])
        && validAnswer(answers['trip-support-2'])
        && validAnswer(answers['trip-support-3']);
    }

    function validMotoAnswers(answers) {
      return exactAnswerKeys(answers, [
          'moto-behavior-1', 'moto-behavior-2', 'moto-behavior-3',
          'moto-management-1', 'moto-management-2', 'moto-management-3',
          'moto-knowledge-1', 'moto-knowledge-2', 'moto-knowledge-3',
          'moto-environment-1', 'moto-environment-2', 'moto-environment-3'
        ])
        && validAnswer(answers['moto-behavior-1'])
        && validAnswer(answers['moto-behavior-2'])
        && validAnswer(answers['moto-behavior-3'])
        && validAnswer(answers['moto-management-1'])
        && validAnswer(answers['moto-management-2'])
        && validAnswer(answers['moto-management-3'])
        && validAnswer(answers['moto-knowledge-1'])
        && validAnswer(answers['moto-knowledge-2'])
        && validAnswer(answers['moto-knowledge-3'])
        && validAnswer(answers['moto-environment-1'])
        && validAnswer(answers['moto-environment-2'])
        && validAnswer(answers['moto-environment-3']);
    }

    function validAgencyAnswers(answers, agencyType) {
      return (
          agencyType == 'road-safety'
          && exactAnswerKeys(answers, ['agency-road-safety-1', 'agency-road-safety-2', 'agency-road-safety-3'])
          && validAnswer(answers['agency-road-safety-1'])
          && validAnswer(answers['agency-road-safety-2'])
          && validAnswer(answers['agency-road-safety-3'])
        ) || (
          agencyType == 'education-area'
          && exactAnswerKeys(answers, ['agency-education-area-4', 'agency-education-area-5', 'agency-education-area-6'])
          && validAnswer(answers['agency-education-area-4'])
          && validAnswer(answers['agency-education-area-5'])
          && validAnswer(answers['agency-education-area-6'])
        ) || (
          agencyType == 'transport'
          && exactAnswerKeys(answers, ['agency-transport-7', 'agency-transport-8', 'agency-transport-9'])
          && validAnswer(answers['agency-transport-7'])
          && validAnswer(answers['agency-transport-8'])
          && validAnswer(answers['agency-transport-9'])
        ) || (
          agencyType == 'local-admin'
          && exactAnswerKeys(answers, ['agency-local-admin-10', 'agency-local-admin-11', 'agency-local-admin-12'])
          && validAnswer(answers['agency-local-admin-10'])
          && validAnswer(answers['agency-local-admin-11'])
          && validAnswer(answers['agency-local-admin-12'])
        );
    }

    function validAnswers(data) {
      return data.answers is map && (
        (data.topicId == 'bus' && data.agencyType == null && validBusAnswers(data.answers))
        || (data.topicId == 'trip' && data.agencyType == null && validTripAnswers(data.answers))
        || (data.topicId == 'moto' && data.agencyType == null && validMotoAnswers(data.answers))
        || (data.topicId == 'agency' && validAgencyAnswers(data.answers, data.agencyType))
      );
    }

    // schema 1 รองรับ client รุ่นก่อนหน้าในช่วง rolling deploy; schema 2 ย้ายข้อมูลผู้ให้ข้อมูลออกจากเอกสารผลประเมิน
    function validSubmissionV1() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'publicConsent', 'institution', 'province',
          'respondentRole', 'position', 'assessmentDate', 'topicId',
          'topicLabel', 'agencyType', 'rubricVersion', 'answers',
          'verificationStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'publicConsent', 'institution', 'province',
          'respondentRole', 'position', 'assessmentDate', 'topicId',
          'topicLabel', 'agencyType', 'rubricVersion', 'answers',
          'verificationStatus', 'createdAt'
        ])
        && data.schemaVersion == 1
        && data.publicConsent == true
        && data.institution is string
        && data.institution.size() >= 2
        && data.institution.size() <= 180
        && validProvince(data.province)
        && validRole(data.respondentRole)
        && data.position is string
        && data.position.size() <= 120
        && data.assessmentDate is string
        && data.assessmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.topicId in ['bus', 'trip', 'moto', 'agency']
        && data.topicLabel is string
        && data.topicLabel.size() >= 2
        && data.topicLabel.size() <= 250
        && (data.agencyType == null || data.agencyType in ['road-safety', 'education-area', 'transport', 'local-admin'])
        && data.rubricVersion == 'TCC-DRAFT-22-06-69-EXACT-01'
        && validAnswers(data)
        && data.verificationStatus == 'self_reported'
        && data.createdAt == request.time;
    }

    function validSubmissionV2() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'publicConsent', 'institution', 'province',
          'assessmentDate', 'topicId', 'topicLabel', 'agencyType',
          'rubricVersion', 'answers', 'verificationStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'publicConsent', 'institution', 'province',
          'assessmentDate', 'topicId', 'topicLabel', 'agencyType',
          'rubricVersion', 'answers', 'verificationStatus', 'createdAt'
        ])
        && data.schemaVersion == 2
        && data.publicConsent == true
        && data.institution is string
        && data.institution.size() >= 2
        && data.institution.size() <= 180
        && validProvince(data.province)
        && data.assessmentDate is string
        && data.assessmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.topicId in ['bus', 'trip', 'moto', 'agency']
        && data.topicLabel is string
        && data.topicLabel.size() >= 2
        && data.topicLabel.size() <= 250
        && (data.agencyType == null || data.agencyType in ['road-safety', 'education-area', 'transport', 'local-admin'])
        && data.rubricVersion == 'TCC-DRAFT-22-06-69-EXACT-01'
        && validAnswers(data)
        && data.verificationStatus == 'self_reported'
        && data.createdAt == request.time;
    }

    function validSubmission() {
      return validSubmissionV1() || validSubmissionV2();
    }

    function validPrivateAssessorV1(submissionId) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'submissionId', 'assessorName', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'submissionId', 'assessorName', 'createdAt'])
        && data.schemaVersion == 1
        && data.submissionId == submissionId
        && data.assessorName is string
        && data.assessorName.size() >= 2
        && data.assessorName.size() <= 120
        && data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/submissions/$(submissionId))
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data.createdAt == request.time;
    }

    function validPrivateAssessorV2(submissionId) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'submissionId', 'assessorName', 'assessorPhone', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'submissionId', 'assessorName', 'assessorPhone', 'createdAt'])
        && data.schemaVersion == 2
        && data.submissionId == submissionId
        && data.assessorName is string
        && data.assessorName.size() >= 2
        && data.assessorName.size() <= 120
        && data.assessorPhone is string
        && data.assessorPhone.size() <= 30
        && data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/submissions/$(submissionId))
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data.createdAt == request.time;
    }

    function validPrivateAssessorV3(submissionId) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'submissionId', 'assessorName', 'assessorPhone', 'respondentRole', 'position', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'submissionId', 'assessorName', 'assessorPhone', 'respondentRole', 'position', 'createdAt'])
        && data.schemaVersion == 3
        && data.submissionId == submissionId
        && data.assessorName is string
        && data.assessorName.size() >= 2
        && data.assessorName.size() <= 120
        && data.assessorPhone is string
        && data.assessorPhone.size() <= 30
        && validRole(data.respondentRole)
        && data.position is string
        && data.position.size() <= 120
        && data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/submissions/$(submissionId))
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId)).data.createdAt == request.time;
    }

    function validPrivateAssessor(submissionId) {
      return validPrivateAssessorV1(submissionId) || validPrivateAssessorV2(submissionId) || validPrivateAssessorV3(submissionId);
    }

    function validBenchmarkCategory(category) {
      return category is map
        && category.keys().hasAll(['id', 'label', 'percent'])
        && category.keys().hasOnly(['id', 'label', 'percent'])
        && category.id is string
        && category.id.size() >= 1
        && category.id.size() <= 80
        && category.label is string
        && category.label.size() >= 1
        && category.label.size() <= 120
        && category.percent is number
        && category.percent >= 0
        && category.percent <= 100;
    }

    function validBenchmark() {
      let data = request.resource.data;
      let categories = data.categoryMedians;
      return data.keys().hasAll([
          'schemaVersion', 'topicId', 'agencyType', 'province', 'scope',
          'sampleSize', 'averageScore', 'medianScore', 'gradeCounts',
          'categoryMedians', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'topicId', 'agencyType', 'province', 'scope',
          'sampleSize', 'averageScore', 'medianScore', 'gradeCounts',
          'categoryMedians', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.topicId in ['bus', 'trip', 'moto', 'agency']
        && (data.agencyType == null || data.agencyType in ['road-safety', 'education-area', 'transport', 'local-admin'])
        && (data.province == null || validProvince(data.province))
        && data.scope in ['province', 'pilot']
        && ((data.scope == 'province' && validProvince(data.province)) || (data.scope == 'pilot' && data.province == null))
        && data.sampleSize is int
        && data.sampleSize >= 10
        && data.averageScore is number
        && data.averageScore >= 0
        && data.averageScore <= 100
        && data.medianScore is number
        && data.medianScore >= 0
        && data.medianScore <= 100
        && data.gradeCounts is map
        && data.gradeCounts.keys().hasAll(['A', 'B', 'C', 'D'])
        && data.gradeCounts.keys().hasOnly(['A', 'B', 'C', 'D'])
        && data.gradeCounts.A is int && data.gradeCounts.A >= 0
        && data.gradeCounts.B is int && data.gradeCounts.B >= 0
        && data.gradeCounts.C is int && data.gradeCounts.C >= 0
        && data.gradeCounts.D is int && data.gradeCounts.D >= 0
        && data.gradeCounts.A + data.gradeCounts.B + data.gradeCounts.C + data.gradeCounts.D == data.sampleSize
        && categories is list
        && categories.size() >= 1
        && categories.size() <= 4
        && validBenchmarkCategory(categories[0])
        && (categories.size() < 2 || validBenchmarkCategory(categories[1]))
        && (categories.size() < 3 || validBenchmarkCategory(categories[2]))
        && (categories.size() < 4 || validBenchmarkCategory(categories[3]))
        && data.updatedAt == request.time;
    }

    match /submissions/{submissionId} {
      // Dashboard อ่านได้เฉพาะ admin, email หรือ domain ที่ผู้ดูแลอนุญาต
      allow read: if hasDashboardAccess();

      // ไม่ใช้ Auth แต่เปิดเฉพาะการสร้างเอกสารรูปแบบที่กำหนด และห้ามแก้/ลบจาก client
      allow create: if submissionId.size() == 36 && validSubmission();
      allow update, delete: if false;
    }

    match /submission_assessors/{submissionId} {
      // ข้อมูลติดต่ออ่านได้เฉพาะ admin หรืออีเมลที่อนุญาตรายบุคคล ไม่เปิดให้สิทธิ์ระดับโดเมน
      allow read: if hasPrivateDashboardAccess();
      allow create: if submissionId.size() == 36 && validPrivateAssessor(submissionId);
      allow update, delete: if false;
    }

    match /benchmarks/{benchmarkId} {
      // มีเฉพาะค่ากลางของกลุ่มอย่างน้อย 10 ราย ไม่มีชื่อ หน่วยงาน หรือคำตอบรายบุคคล
      allow read: if true;
      allow create, update: if isAdmin() && validBenchmark();
      allow delete: if isAdmin();
    }

    match /dashboard_admins/{email} {
      // Superadmin ถูกกำหนดถาวรใน Rules ส่วนบัญชีใน collection นี้เป็น Admin ระดับรอง
      allow get: if hasVerifiedEmail() && email == currentEmail();
      allow list: if isAdmin();
      allow create, update: if isSuperAdmin()
        && !isProtectedSuperAdminEmail(email)
        && validAdminPolicy(email);
      allow delete: if isSuperAdmin()
        && !isProtectedSuperAdminEmail(email)
        && email != currentEmail();
    }

    match /dashboard_members/{email} {
      allow get: if hasVerifiedEmail() && email == currentEmail();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validMemberPolicy(email);
      allow delete: if isAdmin();
    }

    match /dashboard_domains/{domain} {
      allow get: if hasVerifiedEmail() && domain == currentDomain();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validDomainPolicy(domain);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
