VITE_DATA_PROVIDER=firestore
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=tcc-safe-travel.web.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# ไม่บังคับสำหรับรอบทดสอบแรก แต่ควรตั้งค่าก่อนเปิดประชาสัมพันธ์เว็บสาธารณะ
# reCAPTCHA Enterprise ทำงานเบื้องหลังและไม่แสดงโจทย์ให้ผู้ใช้
VITE_FIREBASE_APPCHECK_SITE_KEY=

# เปิดเฉพาะตอนใช้ `npm run firebase:serve`
VITE_FIREBASE_USE_EMULATORS=false
