VITE_DATA_PROVIDER=firestore
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# แนะนำอย่างยิ่งสำหรับเว็บสาธารณะ: reCAPTCHA Enterprise ทำงานเบื้องหลัง ไม่แสดงโจทย์ให้ผู้ใช้
VITE_FIREBASE_APPCHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key

# เปิดเฉพาะตอนใช้ `npm run firebase:serve`
VITE_FIREBASE_USE_EMULATORS=false
